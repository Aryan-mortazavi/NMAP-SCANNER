# Telegram bot token from @BotFather (required)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# PUBLIC_ACCESS=true lets ANY Telegram user use the bot
# When false, only user IDs in ALLOWED_USERS are allowed
PUBLIC_ACCESS=false

# Comma-separated Telegram user IDs allowed to use the bot
# (ignored when PUBLIC_ACCESS=true)
# Get your user ID from @userinfobot
ALLOWED_USERS=123456789,987654321

# Comma-separated CIDR ranges that must never be scanned (optional)
# Example: BLOCKLIST=127.0.0.0/8,10.0.0.0/8,192.168.0.0/16,169.254.0.0/16
BLOCKLIST=

# Optional access code gating the web app (empty = no restriction)
# Visitors must enter it once; a session cookie keeps them logged in.
ACCESS_CODE=

# Optional second factor (TOTP, Google Authenticator / Authy style).
# Generate with: python setup_2fa.py  (then put TOTP_SECRET=... here)
TOTP_SECRET=

# Web app bind address and port (default: 127.0.0.1:8000)
# Use 0.0.0.0 to allow LAN access
HOST=127.0.0.1
PORT=8000

# Scan timeout in seconds (default: 300)
SCAN_TIMEOUT=300

# Cooldown between scans per user in seconds (default: 30)
COOLDOWN_SECONDS=30

# Maximum concurrent scans globally (default: 2)
MAX_CONCURRENT_SCANS=2

# Path to the scan log file (default: scan_logs.txt)
LOG_FILE=scan_logs.txt
